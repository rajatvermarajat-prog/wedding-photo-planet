# Wedding Photo Planet CRM - Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MySQL)
DATABASE_URL="mysql://crm_user:crm_password@localhost:3306/wedding_photo_planet_crm?schema=public"

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_wedding_photo_planet_2026_change_in_production
JWT_EXPIRES_IN=7d
SESSION_SECRET=super_secret_session_key_production_wpp_2026

# Activity & Inactivity Monitor Settings
INACTIVITY_TIMEOUT_MINUTES=10
GRACE_PERIOD_MINUTES=5
AUTO_LOGOUT_ENABLED=true
INACTIVITY_NOTIFICATION_ENABLED=true
LIVE_ACTIVITY_ENABLED=true
ALLOW_MULTIPLE_SESSIONS=false

# File Upload Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Admin Initial Seed Credentials
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@weddingphotoplanet.com
ADMIN_INIT_PASSWORD=ChangeMeAdmin@2026!
ADMIN_INIT_NAME=Studio Owner
