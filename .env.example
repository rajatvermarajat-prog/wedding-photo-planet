# The browser API base URL. Use /api/v1 in production so auth cookies stay
# first-party to the frontend domain; Next proxies this to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin used by Next rewrites. Local default is http://localhost:5050.
API_PROXY_TARGET=https://wedding-photo-planet-backend.vercel.app
