# The Express API base URL. Configure the production value in the deployment environment.
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1

# Optional local-development proxy target. When set alongside
# NEXT_PUBLIC_API_URL=/api/v1, browser API calls remain same-origin and avoid CORS.
# API_PROXY_TARGET=https://wedding-photo-planet-backend.vercel.app
